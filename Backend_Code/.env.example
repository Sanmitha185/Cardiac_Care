# Server Configuration
PORT=5000

# Supabase Persistence Configuration (Server-side Only)
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# NVIDIA AI NIM API Configuration (Server-side Only - NEVER EXPOSE TO CLIENT)
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
SECONDARY_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GUARDRAIL_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
EMBEDDING_MODEL=auto
RERANKER_MODEL=auto
MODEL_DISCOVERY_ENABLED=true
CARDIAC_RAG_ENABLED=true
